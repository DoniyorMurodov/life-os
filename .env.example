# ---------- Frontend (public, safe to expose) — Vercel env vars AND/OR local .env.local ----------
# Cloud sync (Supabase → Project Settings → API)
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- Server only (Vercel → Settings → Environment Variables). NEVER prefix with VITE_ ----------
# AI planner (console.anthropic.com → API Keys)
# ANTHROPIC_API_KEY=sk-ant-...
# Protects your server functions; enter the same code in the app: Settings → AI access code
# APP_ACCESS_CODE=choose-a-private-code

# Background notifications — VAPID keys (npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# Upstash QStash (console.upstash.com → QStash)
# QSTASH_TOKEN=...
# QSTASH_CURRENT_SIGNING_KEY=...
# QSTASH_NEXT_SIGNING_KEY=...
# QSTASH_URL=https://qstash.upstash.io   (use the URL shown in your Upstash console)
